---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-container {
				position: relative;
				width: 100%;
				max-width: 720px;
				aspect-ratio: 16 / 9;
				margin: 3rem auto;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.hero-inner {
				position: absolute;
				inset: 0;
				border: 4px solid #C9A961;
				border-radius: 16px;
				background: #000000;
				overflow: hidden;
				box-shadow: 
					0 0 30px rgba(201, 169, 97, 0.3),
					inset 0 0 30px rgba(201, 169, 97, 0.1),
					0 12px 48px rgba(0, 0, 0, 0.4);
			}

			.logo-wrapper {
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 1;
				position: absolute;
				width: 100%;
				height: 100%;
				padding: 30px;
				box-sizing: border-box;
			}

			.logo-wrapper img {
				max-width: 100%;
				max-height: 100%;
				width: 100%;
				height: 100%;
				object-fit: contain;
				filter: brightness(1.1) contrast(1.1);
				opacity: 1;
			}

			.principles-container {
				position: absolute;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 10;
			}

			.principle {
				position: absolute;
				width: 130px;
				height: 130px;
				box-sizing: border-box;
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: bold;
				font-size: 13px;
				text-align: center;
				padding: 14px;
				border: 3px solid #C9A961;
				background: radial-gradient(circle at 30% 30%, #2a2a2a, #0a0a0a);
				transition: all 0.3s ease;
				box-shadow: 
					inset 0 0 30px rgba(0, 0, 0, 0.8),
					inset 0 0 15px rgba(201, 169, 97, 0.2),
					0 0 30px rgba(0, 0, 0, 0.6),
					0 0 50px rgba(201, 169, 97, 0.2);
				border-radius: 50%;
			}

			.principle::before {
				content: '';
				position: absolute;
				width: 110px;
				height: 110px;
				border-radius: 50%;
				background: radial-gradient(circle at 35% 35%, rgba(201, 169, 97, 0.15), transparent);
				z-index: 1;
			}

			.principle:hover {
				background: radial-gradient(circle at 30% 30%, #3a3a3a, #0a0a0a);
				box-shadow: 
					inset 0 0 40px rgba(0, 0, 0, 0.9),
					inset 0 0 20px rgba(201, 169, 97, 0.3),
					0 0 40px rgba(0, 0, 0, 0.7),
					0 0 60px rgba(201, 169, 97, 0.3);
				transform: scale(1.08);
				border-color: #E8D5A4;
			}

			.principle-top-left {
				top: 12px;
				left: 12px;
				z-index: 5;
			}

			.principle-top-right {
				top: 12px;
				right: 12px;
				z-index: 5;
			}

			.principle-bottom-left {
				bottom: 12px;
				left: 12px;
				z-index: 5;
			}

			.principle-bottom-right {
				bottom: 12px;
				right: 12px;
				z-index: 5;
			}

			.principle-label {
				font-size: 10px;
				color: #E8D5A4;
				margin-top: 5px;
				letter-spacing: 0.8px;
				font-weight: 600;
			}

			.principle-title {
				font-size: 16px;
				font-weight: 700;
				color: #D4AF37;
				letter-spacing: 1px;
			}

			@media (max-width: 520px) {
				.hero-container {
					aspect-ratio: 1;
					margin: 1.5rem auto 2rem;
				}

				.logo-wrapper {
					padding: 72px;
				}

				.principle {
					width: 108px;
					height: 108px;
					padding: 10px;
				}

				.principle::before {
					width: 90px;
					height: 90px;
				}

				.principle-title {
					font-size: 13px;
				}

				.principle-label {
					font-size: 9px;
					line-height: 1.25;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-container">
				<div class="hero-inner">
					<div class="logo-wrapper">
					<img src="/blog-placeholder-corp.jpg" alt="Kuberin Logo" />
					</div>
				</div>

				<div class="principles-container">
					<div class="principle principle-top-left">
						<div>
							<div class="principle-title">MOAT</div>
							<div class="principle-label">Competitive Edge</div>
						</div>
					</div>
					<div class="principle principle-top-right">
						<div>
							<div class="principle-title">MANAGEMENT</div>
							<div class="principle-label">Leadership Quality</div>
						</div>
					</div>
					<div class="principle principle-bottom-left">
						<div>
							<div class="principle-title">MARGIN</div>
							<div class="principle-label">Profitability</div>
						</div>
					</div>
					<div class="principle principle-bottom-right">
						<div>
							<div class="principle-title">MOMENTUM</div>
							<div class="principle-label">Growth Trajectory</div>
						</div>
					</div>
				</div>
			</div>

			<p>
				<strong>Kuberin</strong> applies Charlie Munger's 4 principles for investment and business analysis.
			</p>
			<p>
				The Munger 4 Principles represent a time-tested framework for evaluating business quality:
			</p>
			<ul>
				<li><strong>MOAT</strong> - Sustainable competitive advantages</li>
				<li><strong>MANAGEMENT</strong> - Quality and integrity of leadership</li>
				<li><strong>MARGIN</strong> - Superior profitability metrics</li>
				<li><strong>MOMENTUM</strong> - Consistent growth trajectory</li>
			</ul>
			<p>
				Explore our blog to learn more about business analysis and investment principles.
			</p>
		</main>
		<Footer />
	</body>
</html>
